# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- Stage 1: card data (optional; only raises pokemontcg.io rate limits) ---
# Free key: https://dev.pokemontcg.io
POKEMONTCG_API_KEY=

# --- Stage 5: script (Claude) ---
# Create at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Only for keys not tied to a workspace: Console → Settings → Workspaces → the workspace's ID
ANTHROPIC_WORKSPACE_ID=

# --- Stage 5: voice (ElevenLabs) ---
# Create at https://elevenlabs.io/app/settings/api-keys
# (only "Text to Speech" and "Voices: read" permissions are needed)
ELEVENLABS_API_KEY=
# Pick one with: pokepipe narrate voices
ELEVENLABS_VOICE_ID=
# Your plan's price per 1,000 characters, used for the budget check
ELEVENLABS_USD_PER_1K_CHARS=0.30

# --- Budget ---
BUDGET_USD_PER_VIDEO=1.00
